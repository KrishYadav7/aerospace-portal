      Delete "$DESKTOP\AeroGyan Notes.lnk"
    ${endIf}
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.notes"
    RMDir /r "$SMPROGRAMS\AeroGyan for Professors"
    DeleteRegKey HKCU "Software\tech.aerogyan.pack.professors"
    System::Call 'Shell32::SHChangeNotify(i 0x8000000, i 0, i 0, i 0)'
