    ${endIf}
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.sheets"
    ReadRegStr $R1 HKCU "Software\tech.aerogyan.pack.professors" "desktop_slides"
    ${if} $R1 == "1"
      WinShell::UninstShortcut "$DESKTOP\AeroGyan Slides.lnk"
      Delete "$DESKTOP\AeroGyan Slides.lnk"
    ${endIf}
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.slides"
