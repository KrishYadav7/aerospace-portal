; generated by desktop-app/office/builder.config.js for AeroGyan for Professors (OFFICE_PACK=professors) — do not edit
; Start menu: a folder with every app of the pack; desktop: the first 4 apps.
; Each shortcut runs the one program with --office=<slug>, has the app's own icon and its own
; AppUserModelID (so the taskbar keeps each app apart). Uninstall removes them all.

!macro customInstall
  CreateDirectory "$SMPROGRAMS\AeroGyan for Professors"
  ; AeroGyan Courses
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Courses.lnk" "$appExe" "--office=courses" "$INSTDIR\resources\office-icons\courses.ico" 0 "" "" "Your courses in one place: lectures, notes, PYQs, tests, uploads and the lecture kit."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Courses.lnk" "tech.aerogyan.pack.professors.courses"
  ${ifNot} ${isUpdated}
    ${ifNot} ${FileExists} "$DESKTOP\AeroGyan Courses.lnk"
      CreateShortCut "$DESKTOP\AeroGyan Courses.lnk" "$appExe" "--office=courses" "$INSTDIR\resources\office-icons\courses.ico" 0 "" "" "Your courses in one place: lectures, notes, PYQs, tests, uploads and the lecture kit."
      ClearErrors
      WinShell::SetLnkAUMI "$DESKTOP\AeroGyan Courses.lnk" "tech.aerogyan.pack.professors.courses"
      WriteRegStr HKCU "Software\tech.aerogyan.pack.professors" "desktop_courses" "1"
    ${endIf}
  ${endIf}
  ; AeroGyan Live Classes
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Live Classes.lnk" "$appExe" "--office=live" "$INSTDIR\resources\office-icons\live.ico" 0 "" "" "Go live with camera, screen and board; schedule classes, recordings and who came."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Live Classes.lnk" "tech.aerogyan.pack.professors.live"
  ${ifNot} ${isUpdated}
    ${ifNot} ${FileExists} "$DESKTOP\AeroGyan Live Classes.lnk"
      CreateShortCut "$DESKTOP\AeroGyan Live Classes.lnk" "$appExe" "--office=live" "$INSTDIR\resources\office-icons\live.ico" 0 "" "" "Go live with camera, screen and board; schedule classes, recordings and who came."
      ClearErrors
      WinShell::SetLnkAUMI "$DESKTOP\AeroGyan Live Classes.lnk" "tech.aerogyan.pack.professors.live"
      WriteRegStr HKCU "Software\tech.aerogyan.pack.professors" "desktop_live" "1"
    ${endIf}
  ${endIf}
  ; AeroGyan Attendance
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Attendance.lnk" "$appExe" "--office=attendance" "$INSTDIR\resources\office-icons\attendance.ico" 0 "" "" "Take attendance with a code or QR in seconds; the class list, register and shortage warnings."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Attendance.lnk" "tech.aerogyan.pack.professors.attendance"
  ${ifNot} ${isUpdated}
    ${ifNot} ${FileExists} "$DESKTOP\AeroGyan Attendance.lnk"
      CreateShortCut "$DESKTOP\AeroGyan Attendance.lnk" "$appExe" "--office=attendance" "$INSTDIR\resources\office-icons\attendance.ico" 0 "" "" "Take attendance with a code or QR in seconds; the class list, register and shortage warnings."
      ClearErrors
      WinShell::SetLnkAUMI "$DESKTOP\AeroGyan Attendance.lnk" "tech.aerogyan.pack.professors.attendance"
      WriteRegStr HKCU "Software\tech.aerogyan.pack.professors" "desktop_attendance" "1"
    ${endIf}
  ${endIf}
  ; AeroGyan Grading
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Grading.lnk" "$appExe" "--office=grading" "$INSTDIR\resources\office-icons\grading.ico" 0 "" "" "Mark written answers fast with AI help, translate answer sheets, publish results."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Grading.lnk" "tech.aerogyan.pack.professors.grading"
  ${ifNot} ${isUpdated}
    ${ifNot} ${FileExists} "$DESKTOP\AeroGyan Grading.lnk"
      CreateShortCut "$DESKTOP\AeroGyan Grading.lnk" "$appExe" "--office=grading" "$INSTDIR\resources\office-icons\grading.ico" 0 "" "" "Mark written answers fast with AI help, translate answer sheets, publish results."
      ClearErrors
      WinShell::SetLnkAUMI "$DESKTOP\AeroGyan Grading.lnk" "tech.aerogyan.pack.professors.grading"
      WriteRegStr HKCU "Software\tech.aerogyan.pack.professors" "desktop_grading" "1"
    ${endIf}
  ${endIf}
  ; AeroGyan Gradebook
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Gradebook.lnk" "$appExe" "--office=gradebook" "$INSTDIR\resources\office-icons\gradebook.ico" 0 "" "" "Every mark in one table: offline columns, weights, letter grades and Excel export."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Gradebook.lnk" "tech.aerogyan.pack.professors.gradebook"
  ; AeroGyan Class Insights
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Class Insights.lnk" "$appExe" "--office=insights" "$INSTDIR\resources\office-icons\insights.ico" 0 "" "" "Who is at risk and how each student is doing, with live activity across your courses."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Class Insights.lnk" "tech.aerogyan.pack.professors.insights"
  ; AeroGyan Confusion Map
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Confusion Map.lnk" "$appExe" "--office=confusion" "$INSTDIR\resources\office-icons\confusion.ico" 0 "" "" "Where in each PDF the class got stuck, and what to explain again in the next class."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Confusion Map.lnk" "tech.aerogyan.pack.professors.confusion"
  ; AeroGyan NBA Outcomes
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan NBA Outcomes.lnk" "$appExe" "--office=outcomes" "$INSTDIR\resources\office-icons\outcomes.ico" 0 "" "" "CO–PO attainment for NBA / NAAC from the marks you already have, with the exit survey."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan NBA Outcomes.lnk" "tech.aerogyan.pack.professors.outcomes"
  ; AeroGyan Calendar
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Calendar.lnk" "$appExe" "--office=calendar" "$INSTDIR\resources\office-icons\calendar.ico" 0 "" "" "Classes, deadlines and exams of all your courses in one calendar."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Calendar.lnk" "tech.aerogyan.pack.professors.calendar"
  ; AeroGyan Messages
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Messages.lnk" "$appExe" "--office=messages" "$INSTDIR\resources\office-icons\messages.ico" 0 "" "" "Chat with the AeroGyan team and your colleagues, with files and quick replies."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Messages.lnk" "tech.aerogyan.pack.professors.messages"
  ; AeroGyan Research
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Research.lnk" "$appExe" "--office=research" "$INSTDIR\resources\office-icons\research.ico" 0 "" "" "Post projects, lab openings, thesis topics and internships; pick from the students who apply."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Research.lnk" "tech.aerogyan.pack.professors.research"
  ; AeroGyan Notes Review
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Notes Review.lnk" "$appExe" "--office=notesreview" "$INSTDIR\resources\office-icons\notesreview.ico" 0 "" "" "Notes students sent for your courses: check them and add the good ones to Class Notes."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Notes Review.lnk" "tech.aerogyan.pack.professors.notesreview"
  ; AeroGyan Sheets
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Sheets.lnk" "$appExe" "--office=sheets" "$INSTDIR\resources\office-icons\sheets.ico" 0 "" "" "Spreadsheets like Excel: 430+ formulas, charts with trendlines, edit together, Excel files."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Sheets.lnk" "tech.aerogyan.pack.professors.sheets"
  ; AeroGyan Slides
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Slides.lnk" "$appExe" "--office=slides" "$INSTDIR\resources\office-icons\slides.ico" 0 "" "" "Presentations like Keynote: themes, animations, AI from your notes, presenter view, PowerPoint."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Slides.lnk" "tech.aerogyan.pack.professors.slides"
  ; AeroGyan LaTeX
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan LaTeX.lnk" "$appExe" "--office=latex" "$INSTDIR\resources\office-icons\latex.ico" 0 "" "" "Reports, theses, papers and résumés in LaTeX, with live PDF, templates and AI error help."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan LaTeX.lnk" "tech.aerogyan.pack.professors.latex"
  ; AeroGyan Notes
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Notes.lnk" "$appExe" "--office=notes" "$INSTDIR\resources\office-icons\notes.ico" 0 "" "" "Handwritten notes with pen and finger, that become a neat PDF and LaTeX as you write."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Notes.lnk" "tech.aerogyan.pack.professors.notes"
  StrCpy $launchLink "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Courses.lnk"
  System::Call 'Shell32::SHChangeNotify(i 0x8000000, i 0, i 0, i 0)'
!macroend

!macro customUnInstall
  ${ifNot} ${isUpdated}
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Courses.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Courses.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.courses"
    ReadRegStr $R1 HKCU "Software\tech.aerogyan.pack.professors" "desktop_courses"
    ${if} $R1 == "1"
      WinShell::UninstShortcut "$DESKTOP\AeroGyan Courses.lnk"
      Delete "$DESKTOP\AeroGyan Courses.lnk"
    ${endIf}
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Live Classes.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Live Classes.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.live"
    ReadRegStr $R1 HKCU "Software\tech.aerogyan.pack.professors" "desktop_live"
    ${if} $R1 == "1"
      WinShell::UninstShortcut "$DESKTOP\AeroGyan Live Classes.lnk"
      Delete "$DESKTOP\AeroGyan Live Classes.lnk"
    ${endIf}
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Attendance.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Attendance.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.attendance"
    ReadRegStr $R1 HKCU "Software\tech.aerogyan.pack.professors" "desktop_attendance"
    ${if} $R1 == "1"
      WinShell::UninstShortcut "$DESKTOP\AeroGyan Attendance.lnk"
      Delete "$DESKTOP\AeroGyan Attendance.lnk"
    ${endIf}
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Grading.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Grading.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.grading"
    ReadRegStr $R1 HKCU "Software\tech.aerogyan.pack.professors" "desktop_grading"
    ${if} $R1 == "1"
      WinShell::UninstShortcut "$DESKTOP\AeroGyan Grading.lnk"
      Delete "$DESKTOP\AeroGyan Grading.lnk"
    ${endIf}
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Gradebook.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Gradebook.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.gradebook"
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Class Insights.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Class Insights.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.insights"
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Confusion Map.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Confusion Map.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.confusion"
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan NBA Outcomes.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan NBA Outcomes.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.outcomes"
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Calendar.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Calendar.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.calendar"
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Messages.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Messages.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.messages"
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Research.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Research.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.research"
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Notes Review.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Notes Review.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.notesreview"
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Sheets.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Sheets.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.sheets"
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Slides.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Slides.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.slides"
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan LaTeX.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan LaTeX.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.latex"
    WinShell::UninstShortcut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Notes.lnk"
    Delete "$SMPROGRAMS\AeroGyan for Professors\AeroGyan Notes.lnk"
    WinShell::UninstAppUserModelId "tech.aerogyan.pack.professors.notes"
    RMDir "$SMPROGRAMS\AeroGyan for Professors"
    DeleteRegKey HKCU "Software\tech.aerogyan.pack.professors"
    System::Call 'Shell32::SHChangeNotify(i 0x8000000, i 0, i 0, i 0)'
  ${endIf}
!macroend
