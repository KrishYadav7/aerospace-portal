; generated by desktop-app/office/builder.config.js for AeroGyan for Professors (OFFICE_PACK=professors) — do not edit
; Start-menu folder + desktop: the pack's home (launcher page) and every app of the pack (--office=<slug>),
; each with its own icon and AppUserModelID. Missing desktop shortcuts are made on updates too.
; Uninstall removes them all.

!macro customInstall
  RMDir /r "$SMPROGRAMS\AeroGyan for Professors"
  CreateDirectory "$SMPROGRAMS\AeroGyan for Professors"
  ; AeroGyan for Professors: the pack's home (all apps as tiles)
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\AeroGyan for Professors.lnk" "$appExe" "" "$INSTDIR\resources\office-icons\_pack.ico" 0 "" "" "All 16 apps of AeroGyan for Professors"
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\AeroGyan for Professors.lnk" "tech.aerogyan.pack.professors"
  ReadRegStr $R1 HKCU "Software\tech.aerogyan.pack.professors" "desktop_hub"
  ${If} ${FileExists} "$DESKTOP\AeroGyan for Professors.lnk"
  ${AndIf} $R1 != "1"
    DetailPrint "kept $DESKTOP\AeroGyan for Professors.lnk (not ours)"
  ${Else}
    CreateShortCut "$DESKTOP\AeroGyan for Professors.lnk" "$appExe" "" "$INSTDIR\resources\office-icons\_pack.ico" 0 "" "" "All 16 apps of AeroGyan for Professors"
    ClearErrors
    WinShell::SetLnkAUMI "$DESKTOP\AeroGyan for Professors.lnk" "tech.aerogyan.pack.professors"
    WriteRegStr HKCU "Software\tech.aerogyan.pack.professors" "desktop_hub" "1"
  ${EndIf}
  ; AeroGyan Courses
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\Courses.lnk" "$appExe" "--office=courses" "$INSTDIR\resources\office-icons\courses.ico" 0 "" "" "Your courses in one place: lectures, notes, PYQs, tests, uploads and the lecture kit."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\Courses.lnk" "tech.aerogyan.pack.professors.courses"
  ReadRegStr $R1 HKCU "Software\tech.aerogyan.pack.professors" "desktop_courses"
  ${If} ${FileExists} "$DESKTOP\AeroGyan Courses.lnk"
  ${AndIf} $R1 != "1"
    DetailPrint "kept $DESKTOP\AeroGyan Courses.lnk (not ours)"
  ${Else}
    CreateShortCut "$DESKTOP\AeroGyan Courses.lnk" "$appExe" "--office=courses" "$INSTDIR\resources\office-icons\courses.ico" 0 "" "" "Your courses in one place: lectures, notes, PYQs, tests, uploads and the lecture kit."
    ClearErrors
    WinShell::SetLnkAUMI "$DESKTOP\AeroGyan Courses.lnk" "tech.aerogyan.pack.professors.courses"
    WriteRegStr HKCU "Software\tech.aerogyan.pack.professors" "desktop_courses" "1"
  ${EndIf}
  ; AeroGyan Live Classes
  CreateShortCut "$SMPROGRAMS\AeroGyan for Professors\Live Classes.lnk" "$appExe" "--office=live" "$INSTDIR\resources\office-icons\live.ico" 0 "" "" "Go live with camera, screen and board; schedule classes, recordings and who came."
  ClearErrors
  WinShell::SetLnkAUMI "$SMPROGRAMS\AeroGyan for Professors\Live Classes.lnk" "tech.aerogyan.pack.professors.live"
  ReadRegStr $R1 HKCU "Software\tech.aerogyan.pack.professors" "desktop_live"
  ${If} ${FileExists} "$DESKTOP\AeroGyan Live Classes.lnk"
  ${AndIf} $R1 != "1"
