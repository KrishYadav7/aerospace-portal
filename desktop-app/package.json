{
  "name": "aerogyan-desktop",
  "productName": "AeroGyan",
  "version": "1.0.0",
  "description": "AeroGyan Education — desktop app",
  "author": "AeroGyan Education",
  "homepage": "https://aerogyan.tech",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --aero-selftest=./selftest-out",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "41.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "tech.aerogyan.app",
    "productName": "AeroGyan",
    "copyright": "© AeroGyan Education",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["en-US", "en-GB", "hi"],
    "protocols": [
      { "name": "AeroGyan", "schemes": ["aerogyan"] }
    ],
    "publish": [
      { "provider": "generic", "url": "https://aerogyan.tech/download/windows/" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "AeroGyan-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AeroGyan",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "AeroGyan",
      "artifactName": "AeroGyan-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "AeroGyan-${version}.${ext}",
      "publish": [
        { "provider": "generic", "url": "https://aerogyan.tech/download/mac/" }
      ]
    },
    "dmg": {
      "title": "AeroGyan ${version}",
      "artifactName": "AeroGyan-${version}.${ext}"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "category": "Education",
      "executableName": "aerogyan",
      "synopsis": "AeroGyan Education — courses, notes, tests and live classes",
      "description": "The AeroGyan Education app: your courses, notes, tests, live classes and AI help in their own window, with one sign-in.",
      "maintainer": "AeroGyan Education <apps@aerogyan.tech>",
      "vendor": "AeroGyan Education",
      "desktop": { "entry": { "StartupWMClass": "AeroGyan" } },
      "artifactName": "AeroGyan-${version}.${ext}",
      "publish": [
        { "provider": "generic", "url": "https://aerogyan.tech/download/linux/" }
      ]
    },
    "appImage": { "artifactName": "AeroGyan-${version}.AppImage" },
    "deb": { "artifactName": "AeroGyan-${version}.deb", "packageName": "aerogyan" }
  }
}
